# What a running instance needs, in the order you set it up. Every line is tagged.
# Everything else is a tuning knob with a default in the code — see README.md.

# REQUIRED. From typesafe.ai. Jev judges every answer; nothing runs without it.
TYPESAFE_API_KEY=

# REQUIRED to write the plan (`--plan`), and for an applicant's own questions when
# they apply. OPTIONAL for serving an interview from a plan you already have.
OPENROUTER_API_KEY=

# OPTIONAL, both together. Where records are committed: interviews, applicants,
# approvals. Your own private repository, never the public program one. Unset,
# everything stays on this machine and a restart loses it.
DATA_REPO=
GITHUB_TOKEN=

# REQUIRED. Which plan to run, relative to DATA_REPO (or to this checkout when
# that is unset). This repository ships none: write your brief in your own
# repository, generate a plan from it with `--plan`, commit it, and name it here.
PLAN=

# REQUIRED. Guards /admin and every interview link it issues.
ADMIN_PASSWORD=

# OPTIONAL, but set it on anything long-lived: it signs the interview state the
# browser carries. Random each boot if unset, which invalidates links already sent.
SECRET=
